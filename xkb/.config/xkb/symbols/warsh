    key <AD08> { [ U0671, U0872 ] };                                  // I -> Hamzatul Wasl ٱ, Shift: Hamzatul Wasl 4 ࡼ
    key <AD09> { [ U0629 ] };                                         // O -> Teh Marbuta ة,
    key <AD10> { [ U087B, U087D] };                                   // P -> Hamzatul Wasl 2 ࡻ, Shift: Hamzatul Wasl 3 ࡽ

    // Row C (Home: A-L)
    key <AC01> { [ U0627, U0639 ] };                                  // A -> Alef ا, Shift: Ayn ع
    key <AC02> { [ U0633, U0635 ] };                                  // S -> Seen س, Shift: Sad ص
